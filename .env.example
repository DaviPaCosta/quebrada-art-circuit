# Copie para .env e preencha com os dados do painel do Supabase.
# VITE_SUPABASE_ANON_KEY recebe a "Publishable key" (sb_publishable_...) ou a antiga "anon".
# A chave anon é pública por definição: quem protege os dados são as regras (RLS) do banco.
# NUNCA coloque a Secret key (sb_secret_...) / service_role aqui nem em nenhum arquivo do front.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
